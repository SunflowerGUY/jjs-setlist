rules_version = '2';

// JJ's Setlist - who may read and write what in the online database.
//
//   admins/{uid}                       the app's administrator(s) - added by hand in the Firebase console
//   invites/{code}                     invitation codes: { bandId, bandName }
//   requests/{id}                      "Request an invitation code" messages, for the administrator
//   registered/{uid}                   accounts that signed up with a valid invitation code
//   users/{uid}/...                    each person's personal space (settings, library, setlists, their bands)
//   bands/{bandId}                     a band: { name, inviteCode }
//   bands/{bandId}/members/{uid}       who's in the band
//   bands/{bandId}/data/..., setlists/...   the band's shared song library, settings and setlists
//
// Sign-up needs an invitation code. A login made any other way gets nothing.
// Anything not allowed below is refused.
//
// To use: Firebase console > Firestore Database > Rules, paste this file in, Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isRegistered() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/registered/$(request.auth.uid)));
    }
    function isMember(bandId) {
      return signedIn() && exists(/databases/$(database)/documents/bands/$(bandId)/members/$(request.auth.uid));
    }
    // A current invitation code for this band.
    function validCode(code, bandId) {
      return code is string && code.size() > 0 && code.size() < 40
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.bandId == bandId;
    }

    // The administrator list: you can only check whether you're on it.
    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
    }

    // Invitation codes: anyone may look up a code they were given - but not list them.
    match /invites/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // "Request an invitation code": anyone may send one; only the administrator reads them.
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'band', 'message', 'created'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+') && request.resource.data.email.size() <= 200
        && request.resource.data.band is string && request.resource.data.band.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.created == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Signing up: allowed only with a current invitation code for the band named.
    match /registered/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['email', 'code', 'bandId', 'created'])
        && validCode(request.resource.data.code, request.resource.data.bandId);
      allow delete: if signedIn() && (me() == uid || isAdmin());
      allow update: if false;
    }

    // Personal space: only its owner, and only once signed up properly.
    match /users/{uid}/{document=**} {
      allow read, write: if isRegistered() && me() == uid;
    }

    // Bands: the administrator creates and manages them; members share everything inside.
    match /bands/{bandId} {
      allow get: if isAdmin() || isMember(bandId);
      allow list, create, update, delete: if isAdmin();

      match /members/{uid} {
        allow read: if isAdmin() || isMember(bandId);
        // Join: yourself, with the band's current code (the administrator needs none).
        allow create: if signedIn() && me() == uid
          && (isAdmin() || validCode(request.resource.data.code, bandId));
        // Leave (yourself) or remove (the administrator).
        allow delete: if signedIn() && (me() == uid || isAdmin());
        // Change your own name (shown to the band) - nothing else.
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      }
      match /data/{docId} {
        allow read, write: if isAdmin() || isMember(bandId);
      }
      match /setlists/{name} {
        allow read, write: if isAdmin() || isMember(bandId);
      }
    }
  }
}
